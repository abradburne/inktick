# inktick for nibOS (Arch Linux ARM, aarch64): a Game & Watch emulator that DSlot starts for
# Game & Watch units.
#
# Built from this checkout, not downloaded: prepare() copies the sources into $srcdir, so the
# build never writes to the repository. Dependencies are fetched once, at the versions
# Cargo.lock pins (nibkit from its repository, at the tag Cargo.toml names), and the build
# itself runs offline. On an aarch64 Arch machine (nibOS's build machine):
#
#   cd packaging/nibos && PKGDEST="$PWD/out" BUILDDIR="$HOME/makepkg-build" makepkg -f --nodeps
#
# (--nodeps: the build machine needs Rust and SDL2, not what inktick needs to run.) No ROMs or
# artwork are in the package: the player brings the units' MAME sets.

pkgname=inktick
pkgver=0.1.0
pkgrel=1
pkgdesc="Game & Watch emulator for the Anbernic RG DS+, started from DSlot"
arch=(aarch64)
url="https://github.com/abradburne/inktick"
license=('MIT OR Apache-2.0')
depends=(sdl2-compat)
makedepends=(cargo)
optdepends=('dslot: the game shelf that starts it')

_root=$(cd "$startdir/../.." && pwd)
# nibkit comes from its repository at the tag Cargo.toml names, unless NIBKIT names a local
# checkout to build against instead (patched in, as CONTRIBUTING.md describes).
_nibkit=${NIBKIT:+$(cd "$NIBKIT" && pwd)}

pkgver() {
    sed -n 's/^version = "\(.*\)"/\1/p' "$_root/Cargo.toml" | head -1
}

prepare() {
    rm -rf "$srcdir/inktick" "$srcdir/nibkit"
    mkdir -p "$srcdir/inktick/packaging/nibos"
    cp -r "$_root"/{Cargo.toml,Cargo.lock,crates,README.md,CHANGELOG.md,LICENSE-MIT,LICENSE-APACHE,LICENSE-OFL,THIRD-PARTY.md,docs} "$srcdir/inktick/"
    # Installed for DSlot, and checked against the program's options by a test.
    cp "$_root/packaging/nibos/inktick.toml" "$srcdir/inktick/packaging/nibos/"
    # The build's own Cargo config, not the checkout's (which is each developer's): tuned for the
    # DS+'s Cortex-A55 cores.
    mkdir -p "$srcdir/inktick/.cargo"
    printf '[target.aarch64-unknown-linux-gnu]\nrustflags = ["-C", "target-cpu=cortex-a55"]\n' \
        > "$srcdir/inktick/.cargo/config.toml"
    local locked=--locked
    if [ -n "$_nibkit" ]; then
        mkdir -p "$srcdir/nibkit"
        cp -r "$_nibkit"/{Cargo.toml,build.rs,src,assets,examples,README.md,CHANGELOG.md} "$srcdir/nibkit/"
        cp "$_nibkit"/LICENSE* "$srcdir/nibkit/"
        printf '\n[patch."https://github.com/abradburne/nibkit"]\nnibkit = { path = "%s" }\n' \
            "$srcdir/nibkit" >> "$srcdir/inktick/.cargo/config.toml"
        # Cargo.lock pins the tag's nibkit; the local one replaces it in the copy here.
        locked=
    fi
    cd "$srcdir/inktick"
    cargo fetch $locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$srcdir/inktick"
    cargo build --release --frozen -p inktick --features dslot
    # The units it plays, for DSlot's GW page: set, title, model, year, series.
    target/release/inktick --units >target/release/units.tsv
}

check() {
    cd "$srcdir/inktick"
    # The tests that need the units' sets skip here (they aren't part of the sources).
    cargo test --release --frozen -p inktick-core -p inktick-art -p inktick-sets -p inktick --features inktick/dslot
}

package() {
    cd "$srcdir/inktick"
    install -Dm755 target/release/inktick "$pkgdir/usr/bin/inktick"
    install -Dm644 target/release/units.tsv "$pkgdir/usr/share/inktick/units.tsv"
    install -Dm644 packaging/nibos/inktick.toml "$pkgdir/usr/share/dslot/emulators/inktick.toml"
    install -Dm644 -t "$pkgdir/usr/share/doc/inktick" README.md CHANGELOG.md docs/*.md
    install -Dm644 -t "$pkgdir/usr/share/licenses/inktick" LICENSE-MIT LICENSE-APACHE THIRD-PARTY.md
    # The Roboto Condensed fonts built in (through nibkit) are under the SIL OFL 1.1.
    install -Dm644 LICENSE-OFL "$pkgdir/usr/share/licenses/inktick/OFL.txt"
}
